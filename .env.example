# Copy to .env on the VM and replace every placeholder before starting Nado.
# Generate the admin token with: openssl rand -base64 48
NADO_TOKEN=replace-with-a-long-random-admin-token

# Optional during rotation only. Example:
# NADO_ADMIN_TOKENS=old-admin-token,new-admin-token

# Optional immutable release/deployment identifier shown by status, workers,
# capabilities, and Dashboard build-drift diagnostics. Use the same value for
# Control and Workers built from the same release, for example a full Git SHA.
# NADO_BUILD_ID=0123456789abcdef0123456789abcdef01234567

# Public URL that browsers and remote workers can reach.
# Use https://nado.example.com behind a reverse proxy, or bracket IPv6 literals:
# http://[2001:db8::10]:8765
NADO_PUBLIC_CONTROL_URL=https://nado.example.com

# Public DNS name used by the optional Caddy HTTPS compose overlay. The DNS A
# or AAAA record must resolve to the VM before Caddy can obtain a certificate.
NADO_DOMAIN=nado.example.com

# Enable only when a reverse proxy terminates TLS. Generate a distinct secret
# with `openssl rand -hex 32`, provide it to Nado and the proxy, and have the
# proxy overwrite X-Nado-Proxy-Secret on every upstream request.
NADO_TRUST_PROXY=true
NADO_TRUST_PROXY_SECRET=replace-with-a-distinct-random-proxy-secret

# The native control port is loopback-only by default. Keep this value for VM
# diagnostics and host-installed proxies; remote clients should use HTTPS 443.
NADO_DOCKER_PORT=8765
NADO_DOCKER_HOST_IP=127.0.0.1

# Private-overlay alternative (do not expose TCP 8765 publicly): bind this to
# the VM's tailscale0/wg0 address and set NADO_PUBLIC_CONTROL_URL to the same
# address, for example http://100.64.10.20:8765 or http://10.77.0.1:8765.
# Keep NADO_TRUST_PROXY=false for this direct-listener path. See deploy/overlay.

# Public edge bindings used by docker-compose.azure-https.yml.
NADO_EDGE_HOST_IP=0.0.0.0
NADO_HTTP_PORT=80
NADO_HTTPS_PORT=443

# Production deployments should use SQLite. JSON remains the local/dev default.
NADO_STORE=sqlite

# Optional reliability controls. Automatic recovery is disabled at 0 because
# requeued shell/agent work has at-least-once execution semantics.
NADO_AUTO_RECOVER_OFFLINE_MS=0
NADO_TASK_LEASE_MS=60000
# Prevent concurrent Control processes from overwriting one embedded-store
# volume. A crashed owner is reclaimed only after this heartbeat lease expires.
NADO_CONTROL_DATA_LEASE_TIMEOUT_MS=60000
NADO_CONTROL_DATA_LEASE_HEARTBEAT_MS=10000
NADO_WORKER_RECONNECT_BASE_MS=1000
NADO_WORKER_RECONNECT_MAX_MS=30000
# The worker keeps the task slot and lease while retrying a result that could
# not be delivered because of a transient network, 408/425/429, or 5xx error.
NADO_WORKER_COMPLETION_RETRIES=16
NADO_WORKER_COMPLETION_RETRY_BASE_MS=250
NADO_WORKER_COMPLETION_RETRY_MAX_MS=5000
# Live stdout/stderr events are ordered and retried with stable IDs. The queue
# is bounded; overflow or an exhausted delivery budget creates a gap event.
NADO_TASK_EVENT_RETRIES=8
NADO_TASK_EVENT_RETRY_BASE_MS=250
NADO_TASK_EVENT_RETRY_MAX_MS=5000
NADO_TASK_EVENT_MAX_PENDING=256
# Critical Worker evidence such as post-cancellation process release is retried
# with a stable event ID, so a lost response cannot duplicate durable history.
NADO_WORKER_EVENT_RETRIES=8
NADO_WORKER_EVENT_RETRY_BASE_MS=250
NADO_WORKER_EVENT_RETRY_MAX_MS=5000
NADO_WORKER_LONG_POLL_MS=20000
NADO_WORKER_TOKEN_ROTATION_INTERVAL_MS=0
NADO_NETWORK_PROBE_BYTES=65536
NADO_NETWORK_PROBE_INTERVAL_MS=300000
NADO_NETWORK_PROBE_MIN_INTERVAL_MS=30000

# Control API abuse and memory guards. Set an individual rate to 0 only on a
# trusted development listener when that limiter must be disabled.
NADO_JSON_BODY_MAX_BYTES=67108864
NADO_RATE_LIMIT_WINDOW_MS=60000
NADO_RATE_LIMIT_IP=1800
NADO_RATE_LIMIT_ADMIN=600
NADO_RATE_LIMIT_WORKER=1800
NADO_RATE_LIMIT_ENROLLMENT=60

# Optional append-only NDJSON mirror for Filebeat, Fluent Bit, Vector, or the
# VM's log rotation/archival policy. Keep it outside the control store volume.
# Docker Compose mounts /data/audit separately and reopens the file per event,
# so rename-based log rotation does not require a control restart.
NADO_AUDIT_NDJSON_FILE=/data/audit/nado-audit.ndjson
NADO_AUDIT_NDJSON_MAX_PENDING=1024

# Artifact transfer controls. Files above the inline thresholds are hashed and
# uploaded as resumable raw chunks instead of being embedded in result JSON.
NADO_ARTIFACT_INLINE_MAX_BYTES=5242880
NADO_ARTIFACT_INLINE_TOTAL_BYTES=20971520
NADO_ARTIFACT_CHUNK_BYTES=4194304
NADO_ARTIFACT_MAX_FILE_BYTES=10737418240
NADO_ARTIFACT_MAX_TOTAL_BYTES=53687091200

# Control-to-worker inputs use the same inline/chunk split. Large CLI inputs
# upload before scheduling; workers resume downloads with HTTP byte ranges.
NADO_INPUT_INLINE_MAX_BYTES=5242880
NADO_INPUT_INLINE_TOTAL_BYTES=20971520
NADO_INPUT_CHUNK_BYTES=4194304
NADO_INPUT_MAX_FILE_BYTES=10737418240
NADO_INPUT_MAX_TOTAL_BYTES=53687091200
